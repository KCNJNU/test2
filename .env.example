# PostgreSQL
POSTGRES_DB=cleaning_robot
POSTGRES_USER=cleaning_robot
POSTGRES_PASSWORD=cleaning_robot_dev
DATABASE_URL="postgresql://cleaning_robot:cleaning_robot_dev@localhost:5432/cleaning_robot?schema=public"

# pgAdmin (local development only)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@cleaning-robot.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev

# Object storage (MinIO in development)
OBJECT_STORAGE_ENDPOINT=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=robot-raw-files
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# DVC remote — always separate from OBJECT_STORAGE_BUCKET / robot raw files
DVC_COMMAND=dvc
DVC_REPOSITORY_ROOT=
DVC_REMOTE_NAME=robot-dvc
DVC_REMOTE_ENDPOINT=localhost
DVC_REMOTE_PORT=9000
DVC_REMOTE_USE_SSL=false
DVC_REMOTE_BUCKET=robot-dvc-store
DVC_REMOTE_ACCESS_KEY=minioadmin
DVC_REMOTE_SECRET_KEY=minioadmin
DATASET_PUBLISH_GIT_AUTHOR_NAME=Cleaning Robot Dataset Publisher
DATASET_PUBLISH_GIT_AUTHOR_EMAIL=dataset-publisher@example.invalid
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Applications
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3100
VITE_HEALTH_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1

# Local EMQX (development only; override these values in the root .env)
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=replace-with-a-local-dashboard-password

# Java unified platform API (required; no hidden production defaults)
JAVA_API_PORT=3100
JAVA_DATABASE_URL=jdbc:postgresql://localhost:5432/cleaning_robot
JAVA_DATABASE_USERNAME=cleaning_robot
JAVA_DATABASE_PASSWORD=cleaning_robot_dev
JAVA_CORS_ORIGIN=http://localhost:5173
NEST_INTERNAL_BASE_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
MQTT_BROKER_URI=tcp://localhost:1883
MQTT_CLIENT_ID=robot-platform-java
DEVICE_COMMANDS_ENABLED=false
DEVICE_SIMULATOR_ENABLED=true

# NestJS Device Gateway / Mock Robot Agent (D2 development)
DEVICE_GATEWAY_ENABLED=false
DEVICE_GATEWAY_METRICS_HOST=127.0.0.1
DEVICE_GATEWAY_METRICS_PORT=9464
PROMETHEUS_PORT=9090
DEVICE_GATEWAY_MQTT_CLIENT_ID=robot-platform-device-gateway
# Production overrides: clientId must be device-gateway and all files are Vault-rendered.
MQTT_TLS_CA_FILE=
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=
MQTT_TLS_SERVER_NAME=
MQTT_TLS_REJECT_UNAUTHORIZED=false
MQTT_HEALTH_TLS_CA_FILE=
MQTT_HEALTH_TLS_CERT_FILE=
MQTT_HEALTH_TLS_KEY_FILE=
DEVICE_GATEWAY_POLL_MS=250
COMMAND_ACK_TIMEOUT_MS=10000
ROBOT_UNSTABLE_TIMEOUT_MS=15000
ROBOT_OFFLINE_TIMEOUT_MS=30000
MOCK_ROBOT_ID=
MOCK_ROBOT_SN=
MOCK_ROBOT_SCENARIO=READY

# Local authentication bootstrap. Replace before running the seed; do not use
# these placeholders in a shared or production environment.
BOOTSTRAP_ADMIN_EMAIL=admin@cleaning-robot.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
WORKER_CONCURRENCY=2

# Build/release identity. CI and deployment Compose override these values.
APP_VERSION=0.0.0-dev
GIT_COMMIT=unknown
BUILD_TIME=unknown
DEPLOYMENT_ENVIRONMENT=DEV
RATE_LIMIT_KEY_SALT=development-only-rate-limit-salt
VAULT_AGENT_PROXY_URL=
VAULT_PKI_MOUNT=robot-pki
RESILIENCE_EVIDENCE_TOKEN=
RETENTION_EXECUTION_ENABLED=false
DATABASE_BACKUP_RPO_SECONDS=3600
OBJECT_BACKUP_RPO_SECONDS=21600
RESTORE_DRILL_MAX_AGE_DAYS=35
RELEASE_VERSION=0.0.0-dev
SLOT=local

# D5 OTA / configuration release policy. The public key is not a Secret; the
# matching signing private key must never enter Git or the runtime host.
OTA_SIGNATURE_REQUIRED=false
OTA_SIGNATURE_PUBLIC_KEY_BASE64=
OTA_DOWNLOAD_URL_TTL_SECONDS=900
OTA_MAX_SELECTED_BATCH=50
