# PostgreSQL
POSTGRES_DB=cleaning_robot
POSTGRES_USER=cleaning_robot
POSTGRES_PASSWORD=cleaning_robot_dev
DATABASE_URL="postgresql://cleaning_robot:cleaning_robot_dev@localhost:5432/cleaning_robot?schema=public"

# Object storage (MinIO in development)
OBJECT_STORAGE_ENDPOINT=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=robot-raw-files
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# DVC remote — always separate from OBJECT_STORAGE_BUCKET / robot raw files
DVC_COMMAND=dvc
DVC_REMOTE_NAME=robot-dvc
DVC_REMOTE_ENDPOINT=localhost
DVC_REMOTE_PORT=9000
DVC_REMOTE_USE_SSL=false
DVC_REMOTE_BUCKET=robot-dvc-store
DVC_REMOTE_ACCESS_KEY=minioadmin
DVC_REMOTE_SECRET_KEY=minioadmin
DATASET_PUBLISH_GIT_AUTHOR_NAME=Cleaning Robot Dataset Publisher
DATASET_PUBLISH_GIT_AUTHOR_EMAIL=dataset-publisher@example.invalid
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Applications
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
