# Host-side non-secret deployment configuration. Store the active copy at
# /opt/robot-platform/config/deployment.env with mode 0644 or stricter.
DEPLOYMENT_ENVIRONMENT=TEST
DEPLOY_ROOT=/opt/robot-platform
RUNTIME_ENV_FILE=/opt/robot-platform/config/runtime.env
DVC_REPOSITORY_PATH=/opt/robot-platform/dvc-repository
PLATFORM_RUNTIME_NETWORK=robot-platform-test-runtime
PLATFORM_EDGE_NETWORK=robot-platform-test-edge
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
GATEWAY_METRICS_PORT=9464
# Provision these independently of an application release and pin them by digest.
EDGE_IMAGE=nginxinc/nginx-unprivileged@sha256:replace-with-verified-digest
# EMQX 6.1.4 linux/amd64 platform manifest. Re-approve the platform digest for arm64.
EMQX_IMAGE=emqx/emqx@sha256:4dcdd8a7c053750b550c8a4c5b30a3cfb012edaebe041f84245b1633fab7b77a
TLS_CERT_DIR=/opt/robot-platform/secrets/tls
MQTT_BIND_ADDRESS=0.0.0.0
EMQX_DASHBOARD_BIND_ADDRESS=127.0.0.1
EDGE_SERVER_NAME=platform.example.com
EDGE_CA_FILE=/opt/robot-platform/secrets/tls/edge/ca.pem
