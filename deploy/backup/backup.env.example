# Root-only (0400), rendered by Vault Agent. Image values are non-secret and digest-only.
POSTGRES_TOOLS_IMAGE=postgres@sha256:replace-with-verified-digest
MINIO_CLIENT_IMAGE=minio/mc@sha256:replace-with-verified-digest
RESTIC_IMAGE=restic/restic@sha256:replace-with-verified-digest
CURL_IMAGE=curlimages/curl@sha256:replace-with-verified-digest
DATABASE_URL=postgresql://replace-me
SOURCE_S3_ENDPOINT=https://replace-me
SOURCE_S3_ACCESS_KEY=replace-me
SOURCE_S3_SECRET_KEY=replace-me
SOURCE_S3_BUCKETS=robot-raw-files,robot-dvc-store
RESTIC_REPOSITORY=s3:https://independent-backup.example/robot-platform
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
RESTIC_PASSWORD=replace-me
RESILIENCE_EVIDENCE_TOKEN=replace-me
BACKUP_SOURCE_HOST=production-01
PLATFORM_RUNTIME_NETWORK=robot-platform-production-runtime
BACKUP_STAGING_ROOT=/var/lib/robot-platform-backup
RESTORE_STAGING_ROOT=/var/lib/robot-platform-restore
DEPLOY_ROOT=/opt/robot-platform
RESTORE_DATABASE_URL=postgresql://replace-me-isolated-restore-target
