# This file is a host-only contract. Copy it outside Git, set mode 0600, and
# use environment-owned values. TEST/STAGING/PRODUCTION must never share it.
DATABASE_URL=postgresql://replace-me
JAVA_DATABASE_URL=jdbc:postgresql://replace-me
JAVA_DATABASE_USERNAME=replace-me
JAVA_DATABASE_PASSWORD=replace-me
REDIS_HOST=replace-me
REDIS_PORT=6379
MQTT_BROKER_URI=mqtts://replace-me:8883
EMQX_NODE_COOKIE=replace-me
EMQX_DASHBOARD__DEFAULT_USERNAME=replace-me
EMQX_DASHBOARD__DEFAULT_PASSWORD=replace-me
MQTT_TLS_CA_FILE=/run/secrets/mqtt/ca.pem
MQTT_TLS_CERT_FILE=/run/secrets/mqtt/device-gateway.pem
MQTT_TLS_KEY_FILE=/run/secrets/mqtt/device-gateway-key.pem
MQTT_TLS_SERVER_NAME=mqtt.example.internal
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_HEALTH_TLS_CA_FILE=/run/secrets/mqtt-health/ca.pem
MQTT_HEALTH_TLS_CERT_FILE=/run/secrets/mqtt-health/platform-health.pem
MQTT_HEALTH_TLS_KEY_FILE=/run/secrets/mqtt-health/platform-health-key.pem
OBJECT_STORAGE_ENDPOINT=replace-me
OBJECT_STORAGE_PORT=443
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_BUCKET=replace-me
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
DVC_REMOTE_NAME=replace-me
DVC_REMOTE_ENDPOINT=replace-me
DVC_REMOTE_PORT=443
DVC_REMOTE_USE_SSL=true
DVC_REMOTE_BUCKET=replace-me
DVC_REMOTE_ACCESS_KEY=replace-me
DVC_REMOTE_SECRET_KEY=replace-me
DATASET_PUBLISH_GIT_AUTHOR_NAME=Robot Platform Release
DATASET_PUBLISH_GIT_AUTHOR_EMAIL=replace-me
JAVA_API_PORT=3100
JAVA_CORS_ORIGIN=https://replace-me
CORS_ORIGIN=https://replace-me
NEST_INTERNAL_BASE_URL=http://robot-platform-blue-nest-api:3000
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=12
DEVICE_COMMANDS_ENABLED=false
DEVICE_SIMULATOR_ENABLED=false
DEVICE_GATEWAY_ENABLED=true
DEVICE_GATEWAY_MQTT_CLIENT_ID=device-gateway
DEVICE_GATEWAY_POLL_MS=250
COMMAND_ACK_TIMEOUT_MS=10000
ROBOT_UNSTABLE_TIMEOUT_MS=15000
ROBOT_OFFLINE_TIMEOUT_MS=30000
WORKER_CONCURRENCY=2
OTA_SIGNATURE_REQUIRED=true
OTA_SIGNATURE_PUBLIC_KEY_BASE64=replace-with-ed25519-x509-public-key
OTA_DOWNLOAD_URL_TTL_SECONDS=900
OTA_MAX_SELECTED_BATCH=50
RATE_LIMIT_KEY_SALT=replace-me
VAULT_AGENT_PROXY_URL=http://vault-agent:8201
VAULT_PKI_MOUNT=robot-pki
RESILIENCE_EVIDENCE_TOKEN=replace-me
RETENTION_EXECUTION_ENABLED=false
DATABASE_BACKUP_RPO_SECONDS=3600
OBJECT_BACKUP_RPO_SECONDS=21600
RESTORE_DRILL_MAX_AGE_DAYS=35
